# PostgreSQL (Supabase — use Session pooler on IPv4 networks)
DB_ENABLED=true
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=
DB_NAME=postgres
DB_SSL=true
DB_LOGGING=false
# Opaque UUID from the external base module. Legacy rows are backfilled to this value.
# Also used for public/unauthenticated flows when x-tenant-id is omitted.
# ACTIVE tenant UUID entitled to ALUMNI (used for public/default tenant context)
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001

# IAM OAuth access tokens (shared with taleem-ai-cms-base-module)
# Protected CMS APIs accept Bearer OAuth access tokens only
# (type=oauth + tenantId + roles claims; permissions expanded locally).
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Portal login bridges to base-api (CMS stays on :3000; run base-api on :3010 locally)
IAM_BASE_URL=http://localhost:3010/api/v1
OAUTH_CLIENT_ID=alumni-web
OAUTH_CLIENT_SECRET=AlumniClientSecret2026!
OAUTH_REDIRECT_URI=http://localhost:3001/callback
OAUTH_SCOPE=openid profile tenant.read

# App
PORT=3000
SEED_ADMIN_EMAIL=admin@taleem.local
SEED_ADMIN_PASSWORD=Admin@123
ALUMNI_PORTAL_URL=http://localhost:5173
ADMIN_PORTAL_URL=http://localhost:5174
# Comma-separated extra browser origins (production alumni Vercel is allowed by default)
# CORS_ORIGINS=https://admin.example.com
OPEN_SWAGGER=true
PUBLIC_BASE_URL=http://localhost:3000
ALUMNI_CARD_VERIFY_URL=http://localhost:5173/alumni/verify

# Storage: local | b2 | s3 | minio
STORAGE_DRIVER=b2

# Backblaze B2 (S3-compatible)
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_ACCESS_KEY=your-key-id
S3_SECRET_KEY=your-application-key
S3_BUCKET=taleem-alumni
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URLS=true
S3_SIGNED_URL_TTL_SECONDS=604800
S3_PUBLIC_URL=https://f005.backblazeb2.com/file/taleem-alumni

# Notifications: log | resend | brevo
NOTIFICATION_DRIVER=brevo
BREVO_API_KEY=xkeysib-xxxxxxxx
# Must be a verified sender in Brevo (SMTP & API → Senders)
BREVO_FROM_EMAIL=IKS <rao.shan@ikslogics.com>

# Optional Resend (NOTIFICATION_DRIVER=resend)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Taleem AI <onboarding@resend.dev>

# RSA key pair for frontend password encryption (RSA-OAEP-SHA256) — legacy helpers only
# PASSWORD_PUBLIC_KEY=
# PASSWORD_PRIVATE_KEY=
